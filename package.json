{
  "name": "solosprinter",
  "version": "1.0.0",
  "description": "Personal Kanban board for self-management",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm run build && node server/index.js",
    "mirror": "PORT=3002 node server/index.js --read-only",
    "remote": "PORT=3002 DATA_DIR=./remoteData node server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^9.1.6",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
